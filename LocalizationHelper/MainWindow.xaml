<Window x:Class="LocalizationHelper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:LocalizationHelper"
    mc:Ignorable="d"
    Title="ME3Tweaks Mod Manager INT Localizer" Height="450" Width="1000">
<Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
</Window.Resources>
<Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--<TextBox Grid.RowSpan="2" Grid.ColumnSpan="2" Name="SourceTextbox" TextWrapping="Wrap" AcceptsReturn="True"/>-->
        <DockPanel Grid.RowSpan="2" Grid.ColumnSpan="2">
            <Button DockPanel.Dock="Bottom" Content="{Binding FilterButtonText}" Click="ToggleFilter_Clicked" Margin="0,5,0,0" Padding="5"/>
            <ListBox Name="SourceFile" ItemsSource="{Binding FilesView}" SelectedItem="{Binding SelectedFile}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}" Margin="0,0,5,0" FontSize="14" ToolTip="?? = Has strings needing localization, ? = No strings needed, ? = Not yet scanned"/>
                            <TextBlock Text="{Binding FilePath}" Opacity="{Binding FilePathOpacity}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <TextBox  Grid.Column="2" Grid.ColumnSpan="3" Name="ResultTextBox" IsReadOnly="True" TextWrapping="Wrap"/>
        <TextBox  Grid.Column="2"  Grid.ColumnSpan="3" Grid.Row="1" Name="StringsTextBox" TextWrapping="Wrap" AcceptsReturn="True"/>
        <!--<Button Grid.Row="2" Content="Convert" Click="Convert_Clicked"/>-->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Generate target .cs" Click="PushCSStrings_Clicked" IsEnabled="{Binding SelectedCS}"  ToolTip="Add the strings results to the int.xaml file and then click generate to build modified .cs based on int.xaml substitutions."/>
        <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="Generate target .xaml" Click="PushXamlStrings_Clicked" IsEnabled="{Binding SelectedXAML}"/>

        <Button Grid.Row="2" Grid.Column="4" Content="Update M3L keys" Click="Synchronize_Clicked"/>
        <Button Grid.Row="0" Grid.Column="5" Content="Check .cs localizations" Click="Check_Clicked"/>
        <Button Grid.Row="1" Grid.Column="5" Content="Check .xaml localizations" Click="CheckXamls_Clicked"/>
        <Button Grid.Row="2" Grid.Column="5" Content="Check newline/spaces " Click="CheckXmlSpacePreserve_Clicked"/>
        <Button Margin="0,10,0,0" Grid.Row="3" Grid.Column="5" Content="Open Localization UI " Click="OpenLoalizationUI_Clicked"/>
        <Button Margin="0,10,0,0" Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0" Content="Perform diff on two int.xamls" Click="PerformINTDiff_Clicked"/>
        <Button Margin="0,10,0,0" Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="2" Content="Switch projects" Click="SwitchProjects_Clicked"/>
        
        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" Grid.ColumnSpan="6" Background="#CC000000" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Scanning files for localization status..." FontSize="18" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ScanProgress}" FontSize="14" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <ProgressBar IsIndeterminate="True" Width="300" Height="20"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
