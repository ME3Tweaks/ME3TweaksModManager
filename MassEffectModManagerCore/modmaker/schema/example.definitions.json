    },
    "ai_aimdelay": {
      "label": "Aim Delay",
      "unit": "sec",
      "text": "How long the AI hesitates before firing. The game rolls a value between the two bounds."
    },
    "maxhealth": {
      "label": "Max Health",
      "text": "Base health pool for this enemy at this difficulty."
    }
  },
