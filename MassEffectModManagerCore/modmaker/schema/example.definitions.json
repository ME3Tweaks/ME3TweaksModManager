  "properties": [
    {
      "_shape": "1 + 2 - defined once on the base class, editable on every power, shared text",
      "id": "power.cooldowntime",
      "class": "sfxpowercustomaction",
      "name": "cooldowntime",
      "inheritance": "cascade",
      "value": {
        "kind": "struct",
        "members": [
          {
            "name": "BaseValue",
            "value": {
              "kind": "float",
              "id": "power.cooldowntime.base",
              "describedBy": "cooldowntime",
              "default": 6.0,
              "constraints": {
                "min": 0
              },
              "defaultByClass": {
                "sfxpowercustomaction_pull": 5.0
              },
              "_note": "base class ships 6.0; Pull ships 5.0. The editor shows the class default AND the effective inherited value once ancestors are edited."
            }
          },
          {
            "name": "Formula",
            "value": {
              "kind": "literal",
              "text": "DivideByBonusSum"
            }
          },
          {
            "name": "RankBonuses",
            "value": {
              "kind": "array",
              "items": [
                {
                  "kind": "float",
                  "id": "power.cooldowntime.rank2",
                  "describedBy": "cooldowntime",
                  "label": "Recharge Time Rank 2",
                  "default": 0.0
                },
                {
                  "kind": "float",
                  "id": "power.cooldowntime.rank3",
                  "describedBy": "cooldowntime",
                  "label": "Recharge Time Rank 3",
                  "default": 0.25
                }
              ]
            }
          }
        ]
      }
    },
    {
      "_shape": "3 + 5 - inherited but hidden until the user opts in; leaving it unset means the DLC omits it and Pull keeps the base value",
      "id": "pull.impactradius",
      "class": "sfxpowercustomaction_pull",
      "name": "impactradius",
      "inheritance": "optional",
      "group": "powers.pull",
      "value": {
        "kind": "struct",
        "members": [
          {
            "name": "BaseValue",
            "value": {
              "kind": "float",
              "id": "pull.impactradius.base",
              "describedBy": "impactradius",
              "descriptionAppend": "Pull applies its force negatively, dragging the target toward the caster.",
              "default": 100.0,
              "constraints": {
                "min": 0
              }
            }
          },
          {
            "name": "Formula",
            "value": {
              "kind": "literal",
              "text": "BonusIsHardValue"
            }
          }
        ]
      }
    },
    {
