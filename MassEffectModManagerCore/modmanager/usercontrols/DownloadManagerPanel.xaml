<usercontrols:MMBusyPanelBase
    x:Class="ME3TweaksModManager.modmanager.usercontrols.DownloadManagerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:usercontrols="clr-namespace:ME3TweaksModManager.modmanager.usercontrols"
    xmlns:objects="clr-namespace:ME3TweaksModManager.modmanager.objects"
    xmlns:extensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:nexusmodsintegration="clr-namespace:ME3TweaksModManager.modmanager.nexusmodsintegration"
    mc:Ignorable="d"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Width="500">
    <DockPanel
        Margin="5">
        <TextBlock
            Text="{DynamicResource string_modDownloader}"
            FontSize="20"
            FontWeight="Bold"
            TextAlignment="Center"
            DockPanel.Dock="Top" />
        <Button
            Content="{DynamicResource string_close}"
            DockPanel.Dock="Bottom"
            HorizontalAlignment="Right"
            Command="{Binding CloseCommand}"
            Margin="0,5,0,0" />
        <TextBlock
            Text="{Binding DownloadLocationText}"
            TextWrapping="Wrap"
            DockPanel.Dock="Bottom" />
        <Separator
            DockPanel.Dock="Bottom" />
        <Expander
            DockPanel.Dock="Bottom"
            Margin="0,5,0,0"
            IsExpanded="True"
            DataContext="{Binding FailedDownloads}">
            <Expander.Style>
                <Style
                    TargetType="Expander"
                    BasedOn="{StaticResource {x:Type Expander}}">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding Count, Converter={StaticResource IntGreaterThanConverter}, ConverterParameter=0, Mode=OneWay}"
                            Value="True">
                            <Setter
                                Property="Visibility"
                                Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <Expander.Header>
                <StackPanel
                    Orientation="Horizontal">
                    <TextBlock
                        Text="{DynamicResource string_failedDownloads}"
                        FontWeight="Bold" />
                    <TextBlock
                        Text=" ("
                        FontWeight="Bold"
                        Margin="3,0,0,0" />
                    <TextBlock
                        Text="{Binding Count, Mode=OneWay}"
                        FontWeight="Bold" />
                    <TextBlock
                        Text=")"
                        FontWeight="Bold" />
                </StackPanel>
            </Expander.Header>
            <DockPanel>
                <Button
                    Content="{DynamicResource string_clearAll}"
                    DockPanel.Dock="Bottom"
                    HorizontalAlignment="Right"
                    Margin="0,5,0,0"
                    Padding="7,4"
                    Click="ClearAllFailed_Click">
                    <Button.Style>
                        <Style
                            TargetType="Button"
                            BasedOn="{StaticResource {x:Type Button}}">
                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding Count, Converter={StaticResource IntGreaterThanConverter}, ConverterParameter=1, Mode=OneWay}"
                                    Value="True">
                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ItemsControl
                    ItemsSource="{Binding}"
                    Margin="0,5,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel
                                Margin="0,2,0,2">
                                <Button
                                    Content="✕"
                                    DockPanel.Dock="Right"
                                    Width="26"
                                    Height="26"
                                    Margin="5,0,0,0"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    Click="RemoveFailedDownload_Click"
                                    Tag="{Binding}"
                                    ToolTip="{DynamicResource string_tooltip_removeFailedDownload}" />
                                <StackPanel
                                    DockPanel.Dock="Left"
                                    HorizontalAlignment="Stretch">
                                    <TextBlock
                                        Text="{Binding ModFile.Name}"
                                        FontWeight="Bold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{Binding Status}"
                                        Opacity="0.7"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Expander>
        <ItemsControl
            ItemsSource="{Binding Downloads}">
            <ItemsControl.ItemTemplate>
                <DataTemplate
                    DataType="{x:Type objects:NexusModDownload}">
                    <DockPanel
                        Margin="0,5,0,3">
                        <DockPanel
                            DockPanel.Dock="Top">
                            <StackPanel
                                Visibility="{Binding DownloadState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='MIN_QUEUED', Mode=OneWay}"
                                DockPanel.Dock="Left">
                                <TextBlock
                                    Text="{Binding ModFile.Name}"
                                    FontWeight="Bold" />
                                <TextBlock
                                    Text="{Binding Status}" />
                            </StackPanel>
                            <StackPanel
                                Visibility="{Binding DownloadState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='MAX_INITIALIZING', Mode=OneWay}"
                                DockPanel.Dock="Left">
                                <TextBlock
                                    Text="{DynamicResource string_initializing}"
                                    FontWeight="Bold" />
                                <TextBlock
                                    Text="{DynamicResource string_pleaseWait}" />
                            </StackPanel>
                            <Button
                                Content="{DynamicResource string_import}"
                                DockPanel.Dock="Right"
                                FontSize="10"
                                Height="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,2"
                                Visibility="{Binding CanImport, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding BeginImportCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type usercontrols:DownloadManagerPanel}}}"
                                CommandParameter="{Binding}" />
                        </DockPanel>
                        <ProgressBar
                            Height="7"
                            IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                            Value="{Binding ProgressValue, Mode=OneWay}"
                            Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                            extensions:ProgressBarExtension.IsProgressAnimationEnabled="{Binding IsDownloadActive}" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</usercontrols:MMBusyPanelBase>