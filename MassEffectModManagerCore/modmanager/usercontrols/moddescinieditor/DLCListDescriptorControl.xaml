<UserControl x:Class="ME3TweaksModManager.modmanager.usercontrols.moddescinieditor.DLCListDescriptorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             xmlns:moddescinieditor="clr-namespace:ME3TweaksModManager.modmanager.usercontrols.moddescinieditor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding HeaderText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type moddescinieditor:DLCListDescriptorControl}}, StringFormat='[{0}]'}"
                   FontWeight="Bold"
                   Visibility="{Binding HeaderText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type moddescinieditor:DLCListDescriptorControl}}, Converter={StaticResource NullVisibilityConverter}}"/>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Description, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type moddescinieditor:DLCListDescriptorControl}}}"
                   Visibility="{Binding Description, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type moddescinieditor:DLCListDescriptorControl}}, Converter={StaticResource NullVisibilityConverter}}"
                   MaxWidth="700"
                   TextAlignment="Left"
                   HorizontalAlignment="Left"
                   TextWrapping="Wrap"
                   Margin="0,0,0,5"/>
        <Button DockPanel.Dock="Top"
                Command="{Binding AddEntryCommand}"
                HorizontalAlignment="Left"
                Margin="0,5">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <fa5:ImageAwesome Icon="Solid_Plus"
                                      Width="12"
                                      Height="12"
                                      Margin="0,0,5,0"
                                      Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                    <TextBlock Text="Add"/>
                </StackPanel>
            </Button.Content>
        </Button>
        <ItemsControl DockPanel.Dock="Top"
                      ItemsSource="{Binding DLCEntries}"
                      HorizontalContentAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      Style="{StaticResource ItemsControlVirtualizedStyle}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="24" Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding DLCFolderName, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Left"
                                 Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TPMIModName, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsEnabled="False"
                                 TextAlignment="Left"
                                 Margin="0,0,5,0"/>
                        <Button Grid.Column="2"
                                Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type moddescinieditor:DLCListDescriptorControl}}}"
                                CommandParameter="{Binding}"
                                Width="24"
                                Height="24"
                                Padding="0">
                            <fa5:ImageAwesome Icon="Solid_Minus"
                                              Width="12"
                                              Height="12"
                                              Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
