<usercontrols:MMBusyPanelBase
    x:Class="ME3TweaksModManager.modmanager.usercontrols.CachedTargetsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns:ui="clr-namespace:ME3TweaksModManager.ui"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:usercontrols="clr-namespace:ME3TweaksModManager.modmanager.usercontrols"
    xmlns:converters="clr-namespace:ME3TweaksModManager.modmanager.converters" xmlns:fa5="http://schemas.fontawesome.com/icons/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    MinWidth="700"
    MinHeight="515"
    MaxWidth="1000">
    <UserControl.Resources>
        <converters:GameToImageIconConverter x:Key="GameToImageIconConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:TargetStatusTextConverter x:Key="TargetStatusTextConverter" />
        <converters:TargetStatusBrushConverter x:Key="TargetStatusBrushConverter" />
    </UserControl.Resources>
    <DockPanel>
        <DockPanel
            DockPanel.Dock="Bottom"
            Margin="0,5,0,0">
            <Button
                HorizontalAlignment="Right"
                DockPanel.Dock="Right"
                MinWidth="70"
                Content="Close"
                Margin="5,0,0,0"
                Click="Close_Clicked"
                Padding="7,4" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="3" />
            </Grid.RowDefinitions>
            <!-- Header Panel -->
            <TextBlock
                Text="Manage Cached Targets"
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                FontWeight="Bold"
                FontSize="20"
                TextAlignment="Center" />
            <TextBlock
                TextWrapping="Wrap"
                Text="Mod Manager contains a list of game targets it has seen, known as cached targets. Over time, these may become invalid due to changes such as moving or deleting games. Removing invalid targets will improve application startup time."
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                TextAlignment="Center"
                Margin="0,5,0,0" />
            <Separator
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Margin="0,5" />
            <DockPanel
                Grid.Row="4"
                Grid.Column="1">
                <TextBlock
                    DockPanel.Dock="Top"
                    Text="Cached Targets"
                    FontWeight="Bold"
                    Margin="0,0,0,5" />
                <ListBox
                    Name="TargetsList_ListBox"
                    ItemsSource="{Binding CachedTargets}"
                    SelectedItem="{Binding SelectedTarget}"
                    BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Source="{Binding Game, Converter={StaticResource GameToImageIconConverter}}"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,5,0" />
                                <TextBlock 
                                    Grid.Column="1"
                                    Text="{Binding Game, Converter={StaticResource MEGameToGameNameConverter}}"/>
                                <fa5:ImageAwesome
                                    Grid.Column="2"
                                    Icon="Regular_CheckCircle"
                                    Height="16"
                                    Foreground="{DynamicResource {x:Static adonisUi:Brushes.SuccessBrush}}"
                                    Margin="5,0"
                                    Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <fa5:ImageAwesome
                                    Grid.Column="2"
                                    Icon="Solid_Times"
                                    Height="16"
                                    Foreground="{DynamicResource {x:Static adonisUi:Brushes.ErrorBrush}}"
                                    Margin="5,0"
                                    Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
            <GridSplitter
                Grid.Row="4"
                Grid.Column="2"
                HorizontalAlignment="Stretch" />
            <DockPanel
                Grid.Row="4"
                Grid.Column="3">
                <TextBlock
                    DockPanel.Dock="Top"
                    Text="Target Information"
                    FontWeight="Bold"
                    Margin="0,0,0,5" />
                <ScrollViewer 
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="5">
                        <!-- Game and Status in two columns -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Game Column -->
                            <TextBlock 
                                Grid.Column="0"
                                Grid.Row="0"
                                Text="Game:" 
                                FontWeight="Bold"
                                Margin="0,0,0,3" />
                            <TextBlock 
                                Grid.Column="0"
                                Grid.Row="1"
                                Text="{Binding SelectedTarget.Game}"
                                VerticalAlignment="Top" />
                            
                            <!-- Status Column -->
                            <TextBlock 
                                Grid.Column="2"
                                Grid.Row="0"
                                Text="Status:" 
                                FontWeight="Bold"
                                Margin="0,0,0,3" />
                            <TextBlock 
                                Grid.Column="2"
                                Grid.Row="1"
                                Text="{Binding SelectedTarget, Converter={StaticResource TargetStatusTextConverter}}"
                                Foreground="{Binding SelectedTarget, Converter={StaticResource TargetStatusBrushConverter}}"
                                VerticalAlignment="Top" />
                        </Grid>
                        
                        <TextBlock 
                            Text="Path:" 
                            FontWeight="Bold"
                            Margin="0,0,0,3" />
                        <TextBlock 
                            Text="{Binding SelectedTarget.TargetPath}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,10" />
                        
                        <TextBlock 
                            Text="Failure Reason:" 
                            FontWeight="Bold"
                            Margin="0,0,0,3"
                            Visibility="{Binding SelectedTarget.IsValid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}" />
                        <TextBox 
                            Text="{Binding SelectedTarget.FailureReason, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsReadOnly="True"
                            IsReadOnlyCaretVisible="False"
                            Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                            Margin="0,0,0,10"
                            Visibility="{Binding SelectedTarget.IsValid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}" />
                        
                        <Separator Margin="0,10,0,10" />
                        
                        <TextBlock 
                            Text="Actions" 
                            FontWeight="Bold"
                            Margin="0,0,0,10" />
                        
                        <Button
                            ToolTip="Reloads the selected target to test if it can successfully load"
                            Content="Reload Target"
                            Command="{Binding ReloadTargetCommand}"
                            Padding="7,4"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Stretch" />
                        
                        <Button
                            ToolTip="Restores the game backup for this game to the target's location"
                            Content="Restore Target from backup"
                            Command="{Binding RestoreTargetCommand}"
                            Padding="7,4"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Stretch" />
                        
                        <Button
                            ToolTip="Removes this target from the cache so Mod Manager won't try to load it as a modding target"
                            Content="Remove from Cache"
                            Command="{Binding RemoveTargetCommand}"
                            Padding="7,4"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Stretch" />
                        
                        <Button
                            ToolTip="Enable this backup target to load by removing the backup protection marker"
                            Content="Unlock target"
                            ui:SharedUIBindings.VisibilityToEnabled="True"
                            Command="{Binding UnlockTargetCommand}"
                            Padding="7,4"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            
            <!-- Loading Indicator Overlay -->
            <Border
                Grid.Row="1"
                Grid.RowSpan="4"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
                Opacity="0.95"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <fa5:ImageAwesome
                        Icon="Solid_Spinner"
                        Height="32"
                        Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                        Spin="True"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Loading cached targets..."
                        FontSize="14"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</usercontrols:MMBusyPanelBase>
