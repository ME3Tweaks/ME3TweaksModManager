<usercontrols:MMBusyPanelBase
    x:Class="ME3TweaksModManager.modmanager.usercontrols.CachedTargetsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns:ui="clr-namespace:ME3TweaksModManager.ui"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:usercontrols="clr-namespace:ME3TweaksModManager.modmanager.usercontrols"
    xmlns:converters="clr-namespace:ME3TweaksModManager.modmanager.converters"
    xmlns:fa5="http://schemas.fontawesome.com/icons/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    MinWidth="700"
    MinHeight="515"
    MaxWidth="1000">
    <UserControl.Resources>
        <converters:GameToImageIconConverter
            x:Key="GameToImageIconConverter" />
        <converters:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter" />
        <converters:TargetStatusTextConverter
            x:Key="TargetStatusTextConverter" />
        <converters:TargetStatusBrushConverter
            x:Key="TargetStatusBrushConverter" />
        <converters:NullVisibilityConverter
            x:Key="NullVisibilityConverter" />
    </UserControl.Resources>
    <DockPanel>
        <DockPanel
            DockPanel.Dock="Bottom"
            Margin="0,5,0,0">
            <Button
                HorizontalAlignment="Right"
                DockPanel.Dock="Right"
                MinWidth="70"
                Content="{DynamicResource string_close}"
                Margin="5,0,0,0"
                Click="Close_Clicked"
                Padding="7,4" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="7" />
                <ColumnDefinition
                    Width="350" />
                <ColumnDefinition
                    Width="5" />
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="7" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="3" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
                <RowDefinition
                    Height="3" />
            </Grid.RowDefinitions>
            <!-- Header Panel -->
            <TextBlock
                Text="{DynamicResource string_manageCachedTargets}"
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                FontWeight="Bold"
                FontSize="20"
                TextAlignment="Center" />
            <TextBlock
                TextWrapping="Wrap"
                Text="{DynamicResource string_desc_manageCachedTargets}"
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                TextAlignment="Center"
                Margin="0,5,0,0" />
            <Separator
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Margin="0,5" />
            <DockPanel
                Grid.Row="4"
                Grid.Column="1">
                <TextBlock
                    DockPanel.Dock="Top"
                    Text="{DynamicResource string_cachedTargets}"
                    FontWeight="Bold"
                    Margin="0,0,0,5" />
                <ListBox
                    Name="TargetsList_ListBox"
                    ItemsSource="{Binding CachedTargets}"
                    SelectedItem="{Binding SelectedTarget}"
                    BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="Auto" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Source="{Binding Game, Converter={StaticResource GameToImageIconConverter}}"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,5,0" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Game, Converter={StaticResource MEGameToGameNameConverter}}" />
                                <fa5:ImageAwesome
                                    Grid.Column="2"
                                    Icon="Regular_CheckCircle"
                                    Height="16"
                                    Foreground="{DynamicResource {x:Static adonisUi:Brushes.SuccessBrush}}"
                                    Margin="5,0"
                                    Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <fa5:ImageAwesome
                                    Grid.Column="2"
                                    Icon="Solid_Times"
                                    Height="16"
                                    Foreground="{DynamicResource {x:Static adonisUi:Brushes.ErrorBrush}}"
                                    Margin="5,0"
                                    Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style
                            TargetType="ListBoxItem"
                            BasedOn="{StaticResource ListBoxItemStyle}">
                            <Setter
                                Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
            <GridSplitter
                Grid.Row="4"
                Grid.Column="2"
                HorizontalAlignment="Stretch" />
            <DockPanel
                Grid.Row="4"
                Grid.Column="3">
                <TextBlock
                    DockPanel.Dock="Top"
                    Text="{DynamicResource string_targetInformation}"
                    FontWeight="Bold"
                    Margin="0,0,0,5" />
                <Grid>
                    <!-- No target selected message -->
                    <StackPanel
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding SelectedTarget, Converter={StaticResource NullVisibilityConverter}, ConverterParameter='Reversed'}">
                        <fa5:ImageAwesome
                            Icon="Regular_QuestionCircle"
                            Height="48"
                            Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                            HorizontalAlignment="Center"
                            Opacity="0.5" />
                        <TextBlock
                            Text="{DynamicResource string_noTargetSelected}"
                            FontSize="14"
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"
                            Opacity="0.7" />
                    </StackPanel>
                    <!-- Target information (when target is selected) -->
                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding SelectedTarget, Converter={StaticResource NullVisibilityConverter}}">
                        <StackPanel
                            Margin="5">
                            <!-- Game and Status in two columns -->
                            <Grid
                                Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="10" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="Auto" />
                                    <RowDefinition
                                        Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Game Column -->
                                <TextBlock
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    Text="{DynamicResource string_game}"
                                    FontWeight="Bold"
                                    Margin="0,0,0,3" />
                                <TextBlock
                                    Grid.Column="0"
                                    Grid.Row="1"
                                    Text="{Binding SelectedTarget.Game}"
                                    VerticalAlignment="Top" />
                                <!-- Status Column -->
                                <TextBlock
                                    Grid.Column="2"
                                    Grid.Row="0"
                                    Text="{DynamicResource string_status}"
                                    FontWeight="Bold"
                                    Margin="0,0,0,3" />
                                <TextBlock
                                    Grid.Column="2"
                                    Grid.Row="1"
                                    TextWrapping="Wrap"
                                    Text="{Binding SelectedTarget, Converter={StaticResource TargetStatusTextConverter}}"
                                    Foreground="{Binding SelectedTarget, Converter={StaticResource TargetStatusBrushConverter}}"
                                    VerticalAlignment="Top" />
                            </Grid>
                            <TextBlock
                                Text="{DynamicResource string_path}"
                                FontWeight="Bold"
                                Margin="0,0,0,3" />
                            <TextBlock
                                Text="{Binding SelectedTarget.TargetPath}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,10" />
                            <TextBlock
                                Text="{DynamicResource string_failureReason}"
                                FontWeight="Bold"
                                Margin="0,0,0,3"
                                Visibility="{Binding SelectedTarget.IsValid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}" />
                            <TextBox
                                Text="{Binding SelectedTarget.FailureReason, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsReadOnly="True"
                                IsReadOnlyCaretVisible="False"
                                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                                Margin="0,0,0,10"
                                Visibility="{Binding SelectedTarget.IsValid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}" />
                            <Separator
                                Margin="0,10,0,10" />
                            <TextBlock
                                Text="{DynamicResource string_Actions}"
                                FontWeight="Bold"
                                Margin="0,0,0,10" />
                            <Button
                                ToolTip="{DynamicResource string_tooltip_reloadTarget}"
                                Content="{DynamicResource string_reloadTarget}"
                                Command="{Binding ReloadTargetCommand}"
                                Padding="7,4"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Stretch" />
                            <Button
                                ToolTip="{DynamicResource string_tooltip_restoreTargetFromBackup}"
                                Content="{DynamicResource string_restoreTargetFromBackup}"
                                Command="{Binding RestoreTargetCommand}"
                                Padding="7,4"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Stretch" />
                            <Button
                                ToolTip="{DynamicResource string_tooltip_removeFromCache}"
                                Content="{DynamicResource string_removeFromCache}"
                                Command="{Binding RemoveTargetCommand}"
                                Padding="7,4"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Stretch" />
                            <Button
                                ToolTip="{DynamicResource string_tooltip_unlockTarget}"
                                Content="{DynamicResource string_unlockTarget}"
                                ui:SharedUIBindings.VisibilityToEnabled="True"
                                Command="{Binding UnlockTargetCommand}"
                                Padding="7,4"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
            <!-- Loading Indicator Overlay -->
            <Border
                Grid.Row="1"
                Grid.RowSpan="4"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
                Opacity="0.95"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <fa5:ImageAwesome
                        Icon="Solid_Spinner"
                        Height="32"
                        Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                        Spin="True"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{DynamicResource string_loadingCachedTargets}"
                        FontSize="14"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</usercontrols:MMBusyPanelBase>