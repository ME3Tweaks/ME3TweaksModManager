    <!-- Nexus File Search (Query) -->
    <system:String x:Key="string_nexusModsFileSearch">Recherche de fichiers sur NexusMods</system:String>
    <system:String x:Key="string_description_nexusModsFileSearch">Vous pouvez rechercher des fichiers contenus dans les mods sur NexusMods pour les jeux de la trilogie Mass Effect grâce à la recherche de fichiers NexusMods. La base de données est régulièrement mise à jour et gérée par ME3Tweaks.</system:String>
