    <system:String x:Key="string_dialog_selectWhichLanguagesToIncludeInBackup">Sélectionner les langues à inclure dans la sauvegarde. Les langues non sélectionnées ne seront pas sauvegardées; si vous choisissez de réparer le jeu, ces langues seront retéléchargées.</system:String>
