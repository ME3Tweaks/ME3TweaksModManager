	<system:String x:Key="string_compilingTLKFiles">Compilazione dei file TLK in corso</system:String>
	<system:String x:Key="string_preparingMixinPatchData">Preparazione dei dati delle patch dei Mixing in corso</system:String>
	<system:String x:Key="string_applyingMixins">Applicazione dei Mixin in corso</system:String>
	<system:String x:Key="string_compilingCoalescedFiles">Compilazione dei file Coalesced in corso</system:String>
