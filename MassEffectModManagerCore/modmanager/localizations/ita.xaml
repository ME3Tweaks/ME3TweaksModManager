	<system:String x:Key="string_interp_validation_modjob_replacementFileSpecifiedByJobDoesntExist">Impossibile aggiungere il file di rimpiazzo al job della mod: {0} non esiste ma è specificato dal job.</system:String>
	<system:String x:Key="string_validation_modjob_exeFilesNotAllowed">I file .exe non sono permessi nelle mod del mod manager.</system:String>
	<system:String x:Key="string_validation_modjob_dllFilesNotAllowed">I file .dll non sono permessi nelle mod del mod manager.</system:String>
