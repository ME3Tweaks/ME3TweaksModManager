	<system:String x:Key="string_nexusModsFileSearch">Ricerca dei File di NexusMods</system:String>
	<system:String x:Key="string_description_nexusModsFileSearch">Puoi cercare file contenuti in mod su NexusMods per i giochi della trilogia di Mass Effect con la Ricerca dei File di NexusMods. Il database è regolarmente aggiornato e mantenuto da ME3Tweaks.</system:String>
