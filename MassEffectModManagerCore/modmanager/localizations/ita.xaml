	<system:String x:Key="string_lE1EnableCoalescedMerge">LE1: Abilita Merge Coalesced</system:String>
	<system:String x:Key="string_description_le1CoalescedMergeOption">Disabilitando questa opzione potrai modificare manualmente il tuo file Coalesced, evitando il merge dei file .m3cd all'interno del file Coalesced del gioco base. Potrebbe rompere alcune mod. Non disattivare questa opzione se non sai di cosa si tratta.</system:String>
	<system:String x:Key="string_standardOptionsForME3TweaksModManager">Impostazioni di base di ME3Tweaks Mod Manager.</system:String>
	<system:String x:Key="string_LE1Enable2DAMerge">LE1: Abilita Merge 2DA</system:String>
	<system:String x:Key="string_description_LE1Enable2DAMerge">La disattivazione di questa opzione consente di modificare manualmente le tabelle 2DA nei file del gioco base di LE1 e impedisce ai file .m3da di unirsi alle tabelle 2DA del gioco base. Potrebbe rompere alcune mod. Non disattivare questa opzione se non sai di cosa si tratta.</system:String>
