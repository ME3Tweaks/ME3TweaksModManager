	<system:String x:Key="string_interp_error_outOfOrderTLK">La lista di stringhe {0} in {1} non è in oridne crescente. Le stringhe TLK devono essere in ordine crescente - se uno StringID non è al suo posto, l'analisi del resto del file si fermerà.</system:String>
	<system:String x:Key="string_compressedModItems">Elementi della mod compressi</system:String>
