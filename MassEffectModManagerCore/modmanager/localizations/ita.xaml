	<system:String x:Key="string_errorAuthenticatingToNexusMods">Errore durante l'autenticazione su NexusMods</system:String>
	<system:String x:Key="string_nexusModsLoginHeader">ME3Tweaks Mod Manager supporta funzioni di NexusMods come l'approvazione, il controllo di aggiornamenti e 'Download with Manager'. Devi effettuare il login a NexusMods con ME3Tweaks Mod Manager per usare queste funzioni.</system:String>
	<system:String x:Key="string_directions">Istruzioni</system:String>
	<system:String x:Key="string_nexusModsDirections">Accedi a NexusMods cliccando il pulsante 'Autenticati su NexusMods' qua sotto. In alternativa puoi autorizzarti manualmente incollando la chiave API di NexusMods dopo aver selezionato "Inserisci la chiave API manualmente". Puoi trovare la tua chiave API nelle impostazioni del tuo account su NexusMods.</system:String>
	<system:String x:Key="string_caution">Attenzione</system:String>
	<system:String x:Key="string_doNotShareAPIKeyWarning">Non condividere la tua chiave API con nessuno (screenshot inclusi)! Una chiave API permette a chiunque di effettuare certe azioni a tuo nome e dovresti trattarla come se fosse una password.</system:String>
