	<system:String x:Key="string_tooltip_moveAlternateDown">Sposta l'Alternativo giù</system:String>
	<system:String x:Key="string_mde_validation_customDLCUniqueNames">Le cartelle sorgente e destinazione per CustomDLC devono essere diverse tra loro.</system:String>
	<system:String x:Key="string_mde_dlcModControl">Controlla Mod DLC</system:String>
	<system:String x:Key="string_headmorphs">Headmorph</system:String>
	<system:String x:Key="string_serializeModToShowGeneratedModdesciniFile">Serializza la mod per mostrare il file moddesc.ini generato</system:String>
	<system:String x:Key="string_mde_altFiles_directions">I File Alternativi (DLC Custom) permettono di definire opzioni alternative a valore singolo per l'header del task CUSTOMDLC. Solitamente per l'header del task CUSTOMDLC vorrai utilizzare invece la funzionalità DLC Alternativo.</system:String>
	<system:String x:Key="string_mde_interp_removeTextureModReferenceX">Rimuovere il riferimento alla Texture Mod '{0}'?</system:String>
	<system:String x:Key="string_confirmRemoval">Conferma rimozione</system:String>
	<system:String x:Key="string_mde_description_headmorphs">ME3Tweaks Mod Manager può installare file headmorph attraverso una versione a linea di comando dell'Editor di Salvataggi della Trilogia sviluppato da KarlitosVII. Questi file non sono installati tramite i passaggi principali di installazione di una mod, in quanto dipendono dalla scelta di un salvataggio da parte dell'utente.</system:String>
	<system:String x:Key="string_addHeadmorphReferencesTaskHeader">Aggiungi riferimenti headmorph all'header del task</system:String>
	<system:String x:Key="string_removeHeadmorphReferencesTaskHeader">Rimuovi i riferimenti headmorph dall'header del task</system:String>
	<system:String x:Key="string_autopopulate">Autopopola</system:String>
	<system:String x:Key="string_addHeadmorphFile">Aggiungi file headmorph</system:String>
	<system:String x:Key="string_mde_description_textures" xml:space="preserve">Il ME3Tweaks Mod Manager può installare Texture Mod, ma per permettere agli utenti di trovarle più facilmente è meglio dichiararle come parte della tua mod. Al momento, le texture devono essere installate tramite l'Installatore di Gruppi di Mod.&#10;I file delle Texture Mod (.mem) devono trovarsi nella cartella 'Textures' nella radice del percorso dove si trovano le tue mod.</system:String>
	<system:String x:Key="string_addTextureModReferencesTaskHeader">Aggiungi riferimenti a Texture Mod all'header del task</system:String>
	<system:String x:Key="string_removeAllTextureModReferencesTaskHeader">Rimuovi tutti i riferimenti alle Texture Mod dall'header del task</system:String>
	<system:String x:Key="string_addTextureMod">Aggiungi Texture Mod</system:String>
	<system:String x:Key="string_mde_description_alternatefiles_officialdlc">I File Alternativi permettono di specificare opzioni di installazione alternative per questo task. Queste opzioni sono presentate all'utente prima dell'inizio dell'installazione.</system:String>
	<system:String x:Key="string_mde_description_cmmverUpgradeWarning">Il valore cmmver della tua mod verrà aggiornato durante la serializzazione. Per funzionare correttamente potrebbero essere necessarie ulteriori modifiche.</system:String>
	<system:String x:Key="string_mde_interp_removeHeadmorphReferenceX">Rimuovere il riferimento all'headmorph '{0}'?</system:String>
	<system:String x:Key="string_mde_cloneAlternate">Clona questo Alternativo, posizionandolo direttamente qua sotto.</system:String>
	<system:String x:Key="string_mde_description_asimods">Le mod che richiedono codice nativo aggiuntivo per funzionare correttamente possono richiedere che Mod Manager le installi modificando le impostazioni in questa pagina.</system:String>
	<system:String x:Key="string_mde_warning_asimods">NON MODIFICARE LE IMPOSTAZIONI DI QUESTA PAGINA SE LA TUA MOD NON NECESSITA DI MOD ASI. LE MOD ASI POSSONO FACILMENTE DESTABILIZZARE IL GIOCO. LE MOD CHE LE AGGIUNGONO SENZA MOTIVO POSSONO FINIRE NELLA BLACKLIST DELLE IMPORTAZIONI.</system:String>
	<system:String x:Key="string_addASIMod">Aggiungi Mod ASI</system:String>
	<system:String x:Key="string_tooltip_removeASIFromThisMod">Rimuovi ASI da questa mod</system:String>
	<system:String x:Key="string_asiMod">Mod ASI</system:String>
