<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ME3TweaksModManager.modmanager.windows.DynamicHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
        mc:Ignorable="d"
        Title="Help" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="600">
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}"/>
    </Window.Style>
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="5">
            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource {x:Static adonisUi:Colors.Layer2BorderColor}}"/>
            </Border.BorderBrush>
            <StackPanel Orientation="Horizontal">
                <Button Content="Back" Command="{Binding NavigateBackCommand}" Margin="0,0,5,0" Width="70">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Forward" Command="{Binding NavigateForwardCommand}" Margin="0,0,5,0" Width="70">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
                <Button Content="Home" Command="{Binding NavigateHomeCommand}" Width="70">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Navigation Pane -->
                <ColumnDefinition Width="250" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Content Pane -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation TreeView -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="5">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource {x:Static adonisUi:Colors.Layer2BorderColor}}"/>
                </Border.BorderBrush>
                <TreeView x:Name="HelpTreeView" 
                          ItemsSource="{Binding HelpItems}"
                          SelectedItemChanged="HelpTreeView_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
							<Setter Property="IsExpanded" Value="False"/>
							<!--<Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Colors.Layer2BorderColor}}"/>-->
						</Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <fa5:ImageAwesome Width="16" Height="16" Margin="0,0,5,0"
                                                  Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <fa5:ImageAwesome.Style>
                                        <Style TargetType="fa5:ImageAwesome">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FontAwesomeIconResource}" Value="Solid_InfoCircle">
                                                    <Setter Property="Icon" Value="Solid_InfoCircle"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FontAwesomeIconResource}" Value="Solid_QuestionCircle">
                                                    <Setter Property="Icon" Value="Solid_QuestionCircle"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FontAwesomeIconResource}" Value="Solid_Book">
                                                    <Setter Property="Icon" Value="Solid_Book"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FontAwesomeIconResource}" Value="Solid_Link">
                                                    <Setter Property="Icon" Value="Solid_Link"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </fa5:ImageAwesome.Style>
                                </fa5:ImageAwesome>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Content Display Area -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel">
                    <!-- Title -->
                    <TextBlock x:Name="ContentTitle" 
                               Text="{Binding CurrentContent.Title}"
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="0,0,0,10"
                               Visibility="{Binding HasCurrentContent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    
                    <!-- Icon and Text Content -->
                    <Grid Visibility="{Binding HasCurrentContent, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Modal Icon (if present) -->
                        <fa5:ImageAwesome x:Name="ContentIcon"
                                          Grid.Column="0"
                                          Width="64" 
                                          Height="64" 
                                          Margin="0,0,15,0"
                                          VerticalAlignment="Top"
                                          Visibility="{Binding CurrentContent.HasModalIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                            <fa5:ImageAwesome.Style>
                                <Style TargetType="fa5:ImageAwesome">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentContent.ModalIcon}" Value="INFO">
                                            <Setter Property="Icon" Value="Solid_InfoCircle"/>
                                            <Setter Property="Foreground" Value="RoyalBlue"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentContent.ModalIcon}" Value="WARNING">
                                            <Setter Property="Icon" Value="Solid_ExclamationTriangle"/>
                                            <Setter Property="Foreground" Value="DarkOrange"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentContent.ModalIcon}" Value="ERROR">
                                            <Setter Property="Icon" Value="Solid_Times"/>
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fa5:ImageAwesome.Style>
                        </fa5:ImageAwesome>
                        
                        <!-- Text Content -->
                        <StackPanel Grid.Column="1">
                            <!-- Resource Image -->
                            <Image x:Name="ContentImage" 
                                   Source="{Binding CurrentContent.ResourceImagePath}"
                                   Visibility="{Binding CurrentContent.HasResourceImage, Converter={StaticResource BoolToVisibilityConverter}}"
                                   MaxWidth="400"
                                   Margin="0,0,0,10"
                                   HorizontalAlignment="Left"/>
                            
                            <!-- Modal Text -->
                            <TextBlock x:Name="ContentText" 
                                       Text="{Binding CurrentContent.ModalText}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding CurrentContent.HasModalText, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            
                            <!-- URL Link -->
                            <TextBlock Visibility="{Binding CurrentContent.HasURL, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Margin="0,10,0,0">
                                <Hyperlink NavigateUri="{Binding CurrentContent.URL, Mode=OneWay}" RequestNavigate="Hyperlink_RequestNavigate">
                                    <Run Text="{Binding CurrentContent.URL, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Default message when nothing selected -->
                    <TextBlock Text="Select a topic from the navigation pane to view help content."
                               Visibility="{Binding HasCurrentContent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Not'}"
                               FontStyle="Italic"
                               Foreground="Gray"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
